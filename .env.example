# =============================================================================
# Variáveis de Ambiente — PJ Assistant Agent
# =============================================================================
#
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# NUNCA commite o .env real (está no .gitignore).
# Todas as variáveis são carregadas pelo pydantic-settings (src/core/config.py).
# =============================================================================

# ── LLM (OpenAI) ───────────────────────────────────────────────────
# OPENAI_API_KEY: chave da API OpenAI (obrigatória)
# LLM_MODEL: modelo usado (gpt-4o-mini = melhor custo-benefício)
# LLM_TEMPERATURE: 0.0=determinístico, 1.0=criativo (0.1 = quase determinístico)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ── BFA (Backend Go) ───────────────────────────────────────────────
# URL base do BFA — o agente consulta APIs do BFA se necessário.
# Em dev: localhost:8080 (BFA rodando local)
# Em prod: URL interna do serviço (DNS do Kubernetes)
BFA_BASE_URL=http://localhost:8080

# ── RAG (Retrieval-Augmented Generation) ───────────────────────────
# CHROMA_PERSIST_DIR: onde o ChromaDB salva os dados em disco
# EMBEDDING_MODEL: modelo de embeddings (HuggingFace, roda local em CPU)
# CHUNK_SIZE: tamanho de cada chunk em caracteres (1024 = ~256 tokens)
# CHUNK_OVERLAP: sobreposição entre chunks (evita cortar contexto)
# RAG_TOP_K: quantos chunks retornar na busca semântica
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
RAG_TOP_K=5

# ── Observability ──────────────────────────────────────────────────
# LangFuse: plataforma de monitoramento de LLM (traces, prompts, custos)
# Criar conta grátis em https://cloud.langfuse.com
# LOG_LEVEL: nível de log (DEBUG, INFO, WARNING, ERROR)
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# ── Security (Limites) ─────────────────────────────────────────────
# MAX_INPUT_LENGTH: tamanho máximo da query do cliente (chars)
# MAX_TOKENS_PER_REQUEST: limite de tokens por request (cost control)
# MAX_COST_PER_REQUEST_USD: custo máximo por request (circuit breaker)
MAX_INPUT_LENGTH=2000
MAX_TOKENS_PER_REQUEST=4096
MAX_COST_PER_REQUEST_USD=0.10

# ── Server ──────────────────────────────────────────────────────────
# HOST: 0.0.0.0 = aceita conexões de qualquer IP (necessário em Docker)
# PORT: porta do servidor HTTP
HOST=0.0.0.0
PORT=8000
